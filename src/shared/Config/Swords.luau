Swords.ById = {}
for index, sword in Swords.List do
	sword.index = index
	Swords.ById[sword.id] = sword
end

Swords.Starter = "rouillee"
Swords.CritChance = 0.1

function Swords.get(id: string?)
	return id and Swords.ById[id] or nil
end

-- Intensité de l'effet permanent (0 pour la première épée, 1 pour la dernière).
function Swords.power(sword): number
	local count = #Swords.List
	if not sword or not sword.index or count <= 1 then
		return 0
	end
	return (sword.index - 1) / (count - 1)
end

-- Maîtrise : plus le joueur a vaincu d'ennemis, plus l'effet de son épée est fort (traînée,
-- particules, lueur). Niveau 1 au départ, +1 tous les MasteryStep ennemis, jusqu'à MasteryMax.
-- Calculé depuis la statistique existante « ennemis vaincus » (aucune donnée en plus).
Swords.MasteryStep = 500
Swords.MasteryMax = 4

function Swords.mastery(kills: number?): number
	return math.clamp(1 + math.floor((kills or 0) / Swords.MasteryStep), 1, Swords.MasteryMax)
end

return Swords
