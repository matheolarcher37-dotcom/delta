-- Famille d'effet -> type d'attaque des combats (Characters : attack.kind).
local KIND = {
	impact = "punch",
	orb = "orb",
	rasengan = "orb",
	nails = "orb",
	beam = "beam",
	kamehameha = "beam",
	hollow_purple = "beam",
	bullets = "beam",
	slash = "slash",
	santoryu = "slash",
	dismantle = "slash",
	hinokami = "slash",
	bolt = "lightning",
	chidori = "lightning",
	flame = "flame",
	shadow = "shadow",
	gomu = "stretch",
}
PersosImportes.Kind = KIND

-- Fiches au format de Config/Characters (persos jouables), dans l'ordre de la liste.
function PersosImportes.characters(): { { id: string, def: any } }
	local out = {}
	for _, row in PersosImportes.List do
		local id, name, universe, rarity, signature, fusion, base = table.unpack(row)
		local color = signature.color2 or signature.color
		local def = {
			name = name,
			universe = universe,
			rarity = rarity,
			importe = true,
			look = base,
			-- Perso de secours : l'évolution se voit quand même (énergie puis aura et cheveux plus clairs).
			evolve = {
				[2] = { accessories = { "energy_aura" }, energyColor = signature.color, top = base.top:Lerp(color, 0.25) },
				[3] = { accessories = { "ssj_aura" }, auraColor = signature.color, hairColor = base.hairColor:Lerp(color, 0.35), top = base.top:Lerp(color, 0.35) },
			},
			attack = { kind = KIND[signature.family] or "punch", color = signature.color, name = signature.name },
			fusion = { prefix = fusion[1], suffix = fusion[2] },
			signature = signature,
		}
		table.insert(out, { id = id, def = def })
	end
	return out
end

return PersosImportes
