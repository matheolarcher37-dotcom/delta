-- Persos ajoutés au jeu depuis les modèles de la Boîte à outils (v3.5).
--
-- Leur apparence en jeu = les modèles importés (assets/ModelesPersos, voir tools/import_persos.luau
-- et tools/plan_persos.luau) : un modèle par étoile, ou un seul modèle avec une aura qui grandit à
-- ★★ et ★★★. Les persos qui ont plusieurs formes forment des CHAÎNES : Goko (★ normal, ★★ Super
-- Guerrier, ★★★ Super Guerrier 3, avec des objets d'évolution) puis Goko Divin, un autre perso plus
-- rare à tirer à la machine, qui reprend les formes suivantes (Dieu, Bleu, Kaioken) de la même façon.
--
-- Chaque ligne : identifiant, nom, univers, rareté, attaque signature (famille d'effet, variante,
-- couleurs, nom : voir Config/AttackFx), mots de fusion (préfixe / suffixe), couleurs du perso de
-- secours (peint par le jeu si le modèle manquait : peau, coiffure, cheveux, haut, bas).
-- Les persos d'autres séries sont accueillis dans l'univers qui leur ressemble le plus (Bleach chez
-- les Pourfendeurs, JoJo et Hunter x Hunter sur le Grand Océan, My Hero Academia et One Punch Man
-- sur la Planète des Guerriers, Fate et Death Note à l'Académie Occulte).

local rgb = Color3.fromRGB

local PersosImportes = {}

local SKIN = rgb(255, 216, 180)
local TAN = rgb(226, 178, 138)
local DARK = rgb(150, 100, 70)
local PALE = rgb(246, 228, 214)
local BLACK = rgb(28, 26, 32)
local WHITE = rgb(240, 240, 245)
local CLOAK = rgb(30, 30, 40)

-- { famille, variante, couleur, couleur 2, nom de l'attaque, taille }
local function fx(family: string, variant: string?, color: Color3, color2: Color3, name: string, size: number?)
	return { family = family, variant = variant, color = color, color2 = color2, name = name, size = size or 1 }
end

-- Couleurs du perso de secours.
local function look(skin: Color3, hair: string, hairColor: Color3, top: Color3, bottom: Color3, outfit: string?)
	return { skin = skin, hair = hair, hairColor = hairColor, top = top, bottom = bottom, outfit = outfit or "shirt" }
end

