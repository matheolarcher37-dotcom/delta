-- Remplissage visé : marges pour le contour des lettres et les cadres des panneaux.
TextFit.FillX = 0.92
TextFit.FillY = 0.84
TextFit.MaxSize = 100 -- plafond de Roblox
TextFit.MinSize = 6
-- Carte flottante dimensionnée en studs : sa taille à l'écran dépend de la distance. On vise
-- une distance moyenne (1 stud ≈ 20 pixels) ; le client laisse ensuite Roblox ajuster
-- (Controllers/WorldText).
TextFit.BillboardPixelsPerStud = 20

-- Police d'un texte → clé de METRICS. On lit d'abord l'ancienne propriété Font (renseignée tant
-- que la police vient d'Enum.Font), sinon FontFace (famille + graisse).
local ENUM_KEYS = {
	LuckiestGuy = "LuckiestGuy",
	Bangers = "Bangers",
	Fantasy = "Balthazar",
	Fondamento = "Fondamento",
	FredokaOne = "Fredoka",
	GothamBlack = "Heavy",
	GothamBold = "Bold",
	GothamSemibold = "Bold",
	GothamMedium = "Regular",
	Gotham = "Regular",
}
function TextFit.fontKey(label: Instance): string
	local okFont, font = pcall(function()
		return (label :: any).Font
	end)
	if okFont and typeof(font) == "EnumItem" and font.Name ~= "Unknown" then
		return ENUM_KEYS[font.Name] or "Bold"
	end
	local family, weight = "", nil
	local ok, face = pcall(function()
		return (label :: any).FontFace
	end)
	if ok and face then
		family = string.lower(tostring(face.Family))
		weight = face.Weight
	end
	if string.find(family, "luckiest", 1, true) then
		return "LuckiestGuy"
	elseif string.find(family, "bangers", 1, true) then
		return "Bangers"
	elseif string.find(family, "fondamento", 1, true) then
		return "Fondamento"
	elseif string.find(family, "balthazar", 1, true) then
		return "Balthazar"
	elseif string.find(family, "fredoka", 1, true) then
		return "Fredoka"
	end
	local w = tostring(weight)
	if string.find(w, "Heavy", 1, true) or string.find(w, "Black", 1, true) or string.find(w, "ExtraBold", 1, true) then
		return "Heavy"
	elseif string.find(w, "Bold", 1, true) then
		return "Bold"
	end
	return weight == nil and "Bold" or "Regular"
end

-- Largeur d'un caractère (en tailles de police).
local function charWidth(m, code: number): number
	if code >= 32 and code <= 126 then
		return m.ascii[code - 31] / 100
	elseif code == 0xFE0F or code == 0x200D or code == 0x20E3 then
		return 0 -- sélecteurs d'émoji, liaisons
	elseif code >= 0x1F000 or (code >= 0x2600 and code <= 0x27BF) or (code >= 0x2B00 and code <= 0x2BFF) then
		return 1.2 -- émojis et pictogrammes
	elseif (code >= 0x3000 and code <= 0x9FFF) or (code >= 0xFF00 and code <= 0xFFEF) then
		return 1.0 -- kanjis, kanas
	end
	local w = m.extra[utf8.char(code)]
	return w and w / 100 or 0.75
end

-- Largeur de chaque ligne de `text` (en tailles de police), lignes coupées sur « \n ».
local function lineWidths(m, text: string): { number }
	local widths = { 0 }
	for _, code in utf8.codes(text) do
		if code == 10 then
			table.insert(widths, 0)
		else
			widths[#widths] += charWidth(m, code)
		end
	end
	return widths
end

-- Nombre de lignes de `text` coupé en mots pour tenir dans `maxWidth` (en tailles de police).
local function wrappedLines(m, text: string, maxWidth: number): (number, number)
	local count, widest = 0, 0
	for paragraph in string.gmatch(text .. "\n", "([^\n]*)\n") do
		local current = 0
		count += 1
		for word in string.gmatch(paragraph, "%S+") do
			local w = lineWidths(m, word)[1]
			local space = current > 0 and charWidth(m, 32) or 0
			if current > 0 and current + space + w > maxWidth then
				widest = math.max(widest, current)
				count += 1
				current = w
			else
				current += space + w
			end
		end
		widest = math.max(widest, current)
	end
	return count, widest
end

-- Plus grande taille de police pour que `text` tienne dans `width` x `height` pixels.
function TextFit.size(text: string, key: string, width: number, height: number, opts: { [string]: any }?): number
	local o = opts or {}
	local m = METRICS[key] or METRICS.Bold
	-- La police est dessinée `line` fois plus petite que TextSize ; on plafonne ce facteur à
	-- 1,12 pour Gotham et Fondamento (leur version Roblox peut être un peu plus large).
	local scale = 1 / math.clamp(m.line, 1, 1.12)
	local maxSize = math.min(o.max or TextFit.MaxSize, TextFit.MaxSize)
	local minSize = o.min or TextFit.MinSize
	local lineHeight = o.lineHeight or 1
	local availW = width * (o.fillX or TextFit.FillX)
	local availH = height * (o.fillY or TextFit.FillY)
	if availW <= 0 or availH <= 0 then
		return minSize
	end
	local best
	if o.wrap then
		-- Taille la plus grande dont le texte coupé en mots tient en hauteur.
		local lo, hi = minSize, maxSize
		best = minSize
		while lo <= hi do
			local mid = math.floor((lo + hi) / 2)
			local count, widest = wrappedLines(m, text, availW / (mid * scale))
			if count * mid * lineHeight <= availH and widest * mid * scale <= availW then
				best = mid
				lo = mid + 1
			else
				hi = mid - 1
			end
		end
	else
		local widths = lineWidths(m, text)
		local widest = 0
		for _, w in widths do
			widest = math.max(widest, w)
		end
		best = availH / (#widths * lineHeight)
		if widest > 0 then
			best = math.min(best, availW / (widest * scale))
		end
	end
	return math.clamp(math.floor(best), minSize, maxSize)
end

-- Taille en pixels d'un objet d'interface du décor (nil pour une interface 2D, à l'écran).
function TextFit.pixelSize(object: Instance): Vector2?
	if object:IsA("SurfaceGui") then
		local gui = object :: SurfaceGui
		if gui.SizingMode == Enum.SurfaceGuiSizingMode.FixedSize then
			return gui.CanvasSize
		end
		local part = gui.Adornee or gui.Parent
		if not (part and part:IsA("BasePart")) then
			return nil
		end
		local size = (part :: BasePart).Size
		local face = gui.Face
		local dims
		if face == Enum.NormalId.Front or face == Enum.NormalId.Back then
			dims = Vector2.new(size.X, size.Y)
		elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
			dims = Vector2.new(size.Z, size.Y)
		else
			dims = Vector2.new(size.X, size.Z)
		end
		return dims * gui.PixelsPerStud
	elseif object:IsA("BillboardGui") then
		local size = (object :: BillboardGui).Size
		local pps = TextFit.BillboardPixelsPerStud
		return Vector2.new(size.X.Scale * pps + size.X.Offset, size.Y.Scale * pps + size.Y.Offset)
	elseif object:IsA("GuiObject") then
		local parent = object.Parent
		local parentSize = parent and TextFit.pixelSize(parent)
		if not parentSize then
			return nil
		end
		local padding = parent and parent:FindFirstChildOfClass("UIPadding")
		if padding then
			parentSize -= Vector2.new(
				padding.PaddingLeft.Scale * parentSize.X + padding.PaddingLeft.Offset + padding.PaddingRight.Scale * parentSize.X + padding.PaddingRight.Offset,
				padding.PaddingTop.Scale * parentSize.Y + padding.PaddingTop.Offset + padding.PaddingBottom.Scale * parentSize.Y + padding.PaddingBottom.Offset
			)
		end
		local size = (object :: GuiObject).Size
		return Vector2.new(parentSize.X * size.X.Scale + size.X.Offset, parentSize.Y * size.Y.Scale + size.Y.Offset)
	end
	return nil
end

-- Règle TextSize d'un texte TextScaled d'après la place qu'il occupe (renvoie la taille, ou nil
-- si la place n'est pas connue). Les textes à taille fixe (TextScaled faux) ne sont pas touchés.
function TextFit.fit(label: Instance): number?
	local text = label :: TextLabel
	if not text.TextScaled then
		return nil
	end
	local px = TextFit.pixelSize(text)
	if not px or px.X <= 0 or px.Y <= 0 then
		return nil
	end
	local opts: { [string]: any } = { wrap = text.TextWrapped, lineHeight = text.LineHeight }
	local limit = text:FindFirstChildOfClass("UITextSizeConstraint")
	if limit then
		opts.max = limit.MaxTextSize
		opts.min = math.min(limit.MinTextSize, limit.MaxTextSize)
	end
	local value = text.Text
	if text.RichText then
		value = string.gsub(value, "<[^>]+>", "") -- balises de mise en forme : non affichées
	end
	local size = TextFit.size(value, TextFit.fontKey(text), px.X, px.Y, opts)
	if text.TextSize ~= size then
		text.TextSize = size
	end
	return size
end

-- Change le texte puis règle sa taille.
function TextFit.set(label: Instance, value: string)
	local text = label :: TextLabel
	if text.Text ~= value then
		text.Text = value
	end
	TextFit.fit(text)
end

-- Règle tous les textes TextScaled du décor sous `root` ; renvoie le nombre de textes réglés.
function TextFit.fitAll(root: Instance): number
	local count = 0
	for _, d in root:GetDescendants() do
		if d:IsA("TextLabel") or d:IsA("TextButton") then
			if TextFit.fit(d) then
				count += 1
			end
		end
	end
	return count
end

return TextFit
